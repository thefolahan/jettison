  "tweaks": [
    { "id": "consumer-features", "label": "Stop Windows auto-installing promoted apps", "tier": "Safe",
      "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\CloudContent", "name": "DisableWindowsConsumerFeatures", "type": "DWord", "value": 1 },
    { "id": "silent-installs", "label": "Block silent app installs", "tier": "Safe",
      "path": "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SilentInstalledAppsEnabled", "type": "DWord", "value": 0 },
    { "id": "preinstalled-apps", "label": "Block preinstalled app restore", "tier": "Safe",
      "path": "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "PreInstalledAppsEnabled", "type": "DWord", "value": 0 },
    { "id": "oem-preinstalled-apps", "label": "Block OEM app restore", "tier": "Safe",
      "path": "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "OemPreInstalledAppsEnabled", "type": "DWord", "value": 0 },
    { "id": "start-suggestions", "label": "Remove app suggestions from Start", "tier": "Safe",
      "path": "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SystemPaneSuggestionsEnabled", "type": "DWord", "value": 0 },
    { "id": "settings-suggestions", "label": "Remove suggested content in Settings", "tier": "Safe",
      "path": "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SubscribedContent-338393Enabled", "type": "DWord", "value": 0 },
    { "id": "tips-and-tricks", "label": "Turn off Windows tips and tricks", "tier": "Safe",
      "path": "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SubscribedContent-338389Enabled", "type": "DWord", "value": 0 },
    { "id": "lockscreen-ads", "label": "Turn off lock screen promotions", "tier": "Safe",
      "path": "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SubscribedContent-338387Enabled", "type": "DWord", "value": 0 },
    { "id": "advertising-id", "label": "Disable advertising ID", "tier": "Safe",
      "path": "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\AdvertisingInfo", "name": "Enabled", "type": "DWord", "value": 0 },
    { "id": "tailored-experiences", "label": "Disable tailored experiences", "tier": "Safe",
      "path": "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Privacy", "name": "TailoredExperiencesWithDiagnosticDataEnabled", "type": "DWord", "value": 0 },
    { "id": "telemetry-level", "label": "Set telemetry to the minimum level", "tier": "Safe",
      "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection", "name": "AllowTelemetry", "type": "DWord", "value": 0 },
    { "id": "bing-in-start", "label": "Remove Bing web results from Start search", "tier": "Safe",
      "path": "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Search", "name": "BingSearchEnabled", "type": "DWord", "value": 0 },
    { "id": "startup-delay", "label": "Remove the artificial startup-app delay", "tier": "Safe",
      "path": "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Serialize", "name": "StartupDelayInMSec", "type": "DWord", "value": 0 },

    { "id": "background-apps", "label": "Stop Store apps running in the background", "tier": "Balanced",
      "path": "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\BackgroundAccessApplications", "name": "GlobalUserDisabled", "type": "DWord", "value": 1 },
    { "id": "game-dvr", "label": "Disable background game recording", "tier": "Balanced",
      "path": "HKCU:\\System\\GameConfigStore", "name": "GameDVR_Enabled", "type": "DWord", "value": 0 },
    { "id": "game-dvr-policy", "label": "Disable Game DVR by policy", "tier": "Balanced",
      "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\GameDVR", "name": "AllowGameDVR", "type": "DWord", "value": 0 },
    { "id": "cortana", "label": "Disable Cortana", "tier": "Balanced",
      "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\Windows Search", "name": "AllowCortana", "type": "DWord", "value": 0 },
    { "id": "activity-history", "label": "Stop publishing activity history", "tier": "Balanced",
      "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\System", "name": "PublishUserActivities", "type": "DWord", "value": 0 },
    { "id": "delivery-optimization", "label": "Stop uploading Windows updates to other PCs", "tier": "Balanced",
      "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\DeliveryOptimization", "name": "DODownloadMode", "type": "DWord", "value": 0 },
    { "id": "menu-delay", "label": "Shorten menu open delay (400ms to 50ms)", "tier": "Balanced",
      "path": "HKCU:\\Control Panel\\Desktop", "name": "MenuShowDelay", "type": "String", "value": "50" },

    { "id": "visual-effects", "label": "Set visual effects to best performance", "tier": "Aggressive",
      "path": "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\VisualEffects", "name": "VisualFXSetting", "type": "DWord", "value": 2 },
    { "id": "transparency", "label": "Turn off transparency effects", "tier": "Aggressive",
      "path": "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize", "name": "EnableTransparency", "type": "DWord", "value": 0 }
  ],

