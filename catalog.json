  "cleanup": [
    { "id": "user-temp", "label": "User temp files", "tier": "Safe", "path": "%TEMP%", "minAgeHours": 24 },
    { "id": "windows-temp", "label": "Windows temp files", "tier": "Safe", "path": "%SystemRoot%\\Temp", "minAgeHours": 24 },
    { "id": "error-reports", "label": "Queued Windows error reports", "tier": "Safe", "path": "%ProgramData%\\Microsoft\\Windows\\WER\\ReportQueue", "minAgeHours": 24 },
    { "id": "update-cache", "label": "Windows Update download cache", "tier": "Balanced", "path": "%SystemRoot%\\SoftwareDistribution\\Download", "minAgeHours": 72, "stopService": "wuauserv" },
    { "id": "delivery-optimization-cache", "label": "Delivery Optimization cache", "tier": "Balanced", "path": "%SystemRoot%\\ServiceProfiles\\NetworkService\\AppData\\Local\\Microsoft\\Windows\\DeliveryOptimization\\Cache", "minAgeHours": 24 }
